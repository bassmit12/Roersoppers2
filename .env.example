# Local SQLite file. For production use a libsql URL, e.g. libsql://roersoppers-xxx.turso.io
DATABASE_URL=file:./roersoppers.db
# Only needed for a remote libsql/Turso database
DATABASE_AUTH_TOKEN=

# Long random string, e.g. `openssl rand -hex 32`
PAYLOAD_SECRET=

# Instagram feed (Apify Instagram Scraper)
APIFY_TOKEN=

# Optional: store uploads in Vercel Blob instead of ./media
BLOB_READ_WRITE_TOKEN=
